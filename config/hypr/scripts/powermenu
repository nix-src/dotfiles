#!/usr/bin/env bash
# Меню питания (Super + Shift + Escape или кнопка ⏻ в панели)
choice="$(printf '%s\n' \
    '󰌾  lock' \
    '󰒲  suspend' \
    '󰜉  reboot' \
    '󰐥  shutdown' \
    '󰍃  logout' \
    | fuzzel --dmenu --prompt 'power › ' --lines 5 --width 22)" || exit 0

case "${choice##* }" in
    lock)     loginctl lock-session ;;
    suspend)  systemctl suspend ;;
    reboot)   systemctl reboot ;;
    shutdown) systemctl poweroff ;;
    logout)   uwsm stop ;;
esac
