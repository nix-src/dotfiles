#!/usr/bin/env bash
# Меню питания (Super + Shift + Escape или кнопка ⏻ в панели)
if [[ "$("$HOME/.config/hypr/scripts/lang")" == ru ]]; then
    labels=("блокировка" "сон" "перезагрузка" "выключение" "выход")
    prompt="питание › "
else
    labels=("lock" "suspend" "reboot" "shutdown" "logout")
    prompt="power › "
fi
icons=($'\U000f033e' $'\U000f04b2' $'\U000f0709' $'\U000f0425' $'\U000f0343')

idx="$(for i in "${!labels[@]}"; do printf '%s  %s\n' "${icons[$i]}" "${labels[$i]}"; done \
    | fuzzel --dmenu --index --prompt "$prompt" --lines 5 --width 24)" || exit 0

case "$idx" in
    0) loginctl lock-session ;;
    1) systemctl suspend ;;
    2) systemctl reboot ;;
    3) systemctl poweroff ;;
    4) uwsm stop ;;
esac
