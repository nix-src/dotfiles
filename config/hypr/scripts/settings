import signal
import subprocess
import sys

if __name__ == "__main__" and "--standalone" not in sys.argv:
    try:
        with open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "dotfiles-ui.pid")) as _f:
            _pid = int(_f.read().strip())
        with open(f"/proc/{_pid}/cmdline", "rb") as _f:
            _ours = b"scripts/player" in _f.read()
        if _ours:
            os.kill(_pid, signal.SIGUSR2)
            sys.exit(0)
    except (OSError, ValueError):
        pass

