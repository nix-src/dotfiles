#!/usr/bin/env python3
"""Окно настроек окружения (Super + I или шестерёнка в панели).

Хранит значения в ~/.config/dotfiles-local/ (вне репозитория):
  settings.json   — состояние окна
  settings.lua    — читается hyprland.lua при загрузке
  hypridle.conf   — таймауты блокировки/экрана/сна
  wallpaper       — режим обоев (animated | static | none)
"""
import json
import os
import shutil
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

HOME = os.path.expanduser("~")
LOCAL = os.path.join(HOME, ".config", "dotfiles-local")
SCRIPTS = os.path.join(HOME, ".config", "hypr", "scripts")
JSON_PATH = os.path.join(LOCAL, "settings.json")

# Должны совпадать со значениями по умолчанию в hyprland.lua / canvas.lua
DEFAULTS = {
    "monitors": {},
    "kb_layout": "us,ru",
    "kb_options": "grp:alt_shift_toggle",
    "sensitivity": 0.0,
    "accel_flat": False,
    "natural_scroll": False,
    "repeat_rate": 35,
    "repeat_delay": 250,
    "gaps_in": 4,
    "gaps_out": 8,
    "border_size": 1,
    "animations": True,
    "border_anim": True,
    "dim_inactive": True,
    "terminal": "kitty",
    "browser": "firefox",
    "files": "thunar",
    "canvas": {"spread": 1.35, "shrink": 0.82, "pad": 0.35, "friction": 0.94},
    "wallpaper": "animated",
    "idle": {"lock": 10, "screen_off": 15, "suspend": 0},
}

LAYOUT_SWITCH = [
    ("Alt + Shift", "grp:alt_shift_toggle"),
    ("Ctrl + Shift", "grp:ctrl_shift_toggle"),
    ("Super + Space", "grp:win_space_toggle"),
    ("Caps Lock", "grp:caps_toggle"),
]
WALLPAPER = [("анимированные", "animated"), ("статичные", "static"), ("нет (сплошной фон)", "none")]

CSS = """
window { background: #0f0f0f; }
.sidebar { background: #0b0b0b; border-right: 1px solid #1f1f1f; }
stacksidebar row { padding: 10px 18px; }
.page { padding: 24px 28px; }
.title { font-size: 18px; font-weight: bold; color: #ededed; margin-bottom: 12px; }
.section { color: #6b6b6b; font-size: 11px; margin-top: 14px; }
.row { padding: 6px 0; border-bottom: 1px solid #191919; }
.row label.name { color: #c8c8c8; }
.row label.hint { color: #5a5a5a; font-size: 11px; }
.footer { padding: 12px 20px; border-top: 1px solid #1f1f1f; background: #0b0b0b; }
button.apply { background: #c8c8c8; color: #0b0b0b; }
button.apply:hover { background: #ededed; }
button.tool { padding: 10px 14px; }
"""


# --------------------------------------------------------------------- данные

def deep_merge(base, over):
    out = json.loads(json.dumps(base))
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k].update(v)
        else:
            out[k] = v
    return out


def load_settings():
    try:
        with open(JSON_PATH) as f:
            return deep_merge(DEFAULTS, json.load(f))
    except (OSError, ValueError):
        return deep_merge(DEFAULTS, {})


def lua_value(v, indent=1):
    pad = "    " * indent
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(round(v, 4)) if isinstance(v, float) else str(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, dict):
        if not v:
            return "{}"
        items = []
        for k, val in v.items():
            key = k if k.isidentifier() else "[" + json.dumps(k) + "]"
            items.append(f"{pad}{key} = {lua_value(val, indent + 1)},")
        return "{\n" + "\n".join(items) + "\n" + "    " * (indent - 1) + "}"
    raise TypeError(type(v))


def write_files(s):
    os.makedirs(LOCAL, exist_ok=True)
    with open(JSON_PATH, "w") as f:
        json.dump(s, f, indent=2, ensure_ascii=False)

    lua = {k: v for k, v in s.items() if k not in ("wallpaper", "idle")}
    with open(os.path.join(LOCAL, "settings.lua"), "w") as f:
        f.write("-- Сгенерировано окном настроек. Правки вручную будут перезаписаны.\n")
        f.write("return " + lua_value(lua) + "\n")

    with open(os.path.join(LOCAL, "wallpaper"), "w") as f:
        f.write(s["wallpaper"])

    idle = s["idle"]
    parts = [
        "general {\n"
        "    lock_cmd         = pidof hyprlock || hyprlock\n"
        "    before_sleep_cmd = loginctl lock-session\n"
        "    after_sleep_cmd  = hyprctl dispatch 'hl.dsp.dpms({action=\"on\"})'\n"
        "}\n"
    ]
    if idle["lock"] > 0:
        parts.append(f"listener {{\n    timeout    = {int(idle['lock'] * 60)}\n"
                     "    on-timeout = loginctl lock-session\n}\n")
    if idle["screen_off"] > 0:
        parts.append(f"listener {{\n    timeout    = {int(idle['screen_off'] * 60)}\n"
                     "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({action=\"off\"})'\n"
                     "    on-resume  = hyprctl dispatch 'hl.dsp.dpms({action=\"on\"})'\n}\n")
    if idle["suspend"] > 0:
        parts.append(f"listener {{\n    timeout    = {int(idle['suspend'] * 60)}\n"
                     "    on-timeout = systemctl suspend\n}\n")
    with open(os.path.join(LOCAL, "hypridle.conf"), "w") as f:
        f.write("\n".join(parts))


def spawn(*cmd):
    subprocess.Popen(cmd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def monitors():
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3)
        return json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


# --------------------------------------------------------------------- виджеты

def row(name, widget, hint=None):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
    box.add_css_class("row")
    labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
    lbl = Gtk.Label(label=name, xalign=0)
    lbl.add_css_class("name")
    labels.append(lbl)
    if hint:
        h = Gtk.Label(label=hint, xalign=0, wrap=True)
        h.add_css_class("hint")
        labels.append(h)
    box.append(labels)
    widget.set_valign(Gtk.Align.CENTER)
    box.append(widget)
    return box


def section(text):
    lbl = Gtk.Label(label=text.upper(), xalign=0)
    lbl.add_css_class("section")
    return lbl


def spin(lo, hi, step, value, digits=0):
    w = Gtk.SpinButton.new_with_range(lo, hi, step)
    w.set_digits(digits)
    w.set_value(value)
    return w


def slider(lo, hi, step, value, digits=2):
    w = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
    w.set_digits(digits)
    w.set_draw_value(True)
    w.set_value(value)
    w.set_size_request(240, -1)
    return w


def switch(value):
    w = Gtk.Switch()
    w.set_active(bool(value))
    return w


def entry(value, width=220):
    w = Gtk.Entry(text=str(value))
    w.set_size_request(width, -1)
    return w


def dropdown(options, current):
    labels = [o[0] for o in options]
    w = Gtk.DropDown.new_from_strings(labels)
    values = [o[1] for o in options]
    w.set_selected(values.index(current) if current in values else 0)
    w.values = values
    return w


def dd_value(w):
    return w.values[w.get_selected()]


# ----------------------------------------------------------------------- окно

class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Настройки")
        self.set_default_size(900, 620)
        self.s = load_settings()
        self.w = {}

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, vexpand=True)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True)
        side = Gtk.StackSidebar(stack=self.stack)
        side.add_css_class("sidebar")
        side.set_size_request(190, -1)
        body.append(side)
        body.append(self.stack)
        root.append(body)
        root.append(self.footer())
        self.set_child(root)
        self.build()

    # ------------------------------------------------------------ страницы
    def page(self, name, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.add_css_class("page")
        t = Gtk.Label(label=title, xalign=0)
        t.add_css_class("title")
        box.append(t)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        sc.set_child(box)
        self.stack.add_titled(sc, name, title)
        return box

    def build(self):
        s, w = self.s, self.w

        # Экран
        p = self.page("display", "Экран")
        self.mon = {}
        mons = monitors()
        if not mons:
            p.append(Gtk.Label(label="Нет данных от Hyprland", xalign=0))
        for m in mons:
            name = m["name"]
            saved = s["monitors"].get(name, {})
            modes = []
            for mode in m.get("availableModes", []):
                v = mode.removesuffix("Hz")
                if v not in [x[1] for x in modes]:
                    modes.append((mode, v))
            modes.insert(0, ("авто (preferred)", "preferred"))
            p.append(section(f"{name} — {m.get('description', '')}"))
            mode_w = dropdown(modes, saved.get("mode", "preferred"))
            scale_w = spin(0.5, 3, 0.25, float(saved.get("scale", m.get("scale", 1))), 2)
            pos_w = entry(saved.get("position", "auto"), 140)
            p.append(row("Разрешение и частота", mode_w))
            p.append(row("Масштаб", scale_w))
            p.append(row("Позиция", pos_w, "auto или XxY, например 1920x0"))
            self.mon[name] = (mode_w, scale_w, pos_w)

        # Ввод
        p = self.page("input", "Клавиатура и мышь")
        p.append(section("клавиатура"))
        w["kb_layout"] = entry(s["kb_layout"])
        p.append(row("Раскладки", w["kb_layout"], "через запятую, например us,ru,ua"))
        sw = [o for o in s["kb_options"].split(",") if o.startswith("grp:")]
        w["kb_switch"] = dropdown(LAYOUT_SWITCH, sw[0] if sw else "")
        p.append(row("Переключение раскладки", w["kb_switch"]))
        w["repeat_rate"] = spin(10, 80, 1, s["repeat_rate"])
        p.append(row("Скорость повтора клавиш", w["repeat_rate"], "символов в секунду"))
        w["repeat_delay"] = spin(150, 800, 10, s["repeat_delay"])
        p.append(row("Задержка до повтора", w["repeat_delay"], "мс"))
        p.append(section("мышь"))
        w["sensitivity"] = slider(-1, 1, 0.05, s["sensitivity"])
        p.append(row("Чувствительность", w["sensitivity"]))
        w["accel_flat"] = switch(s["accel_flat"])
        p.append(row("Без ускорения", w["accel_flat"], "одинаковая скорость при любом движении"))
        w["natural_scroll"] = switch(s["natural_scroll"])
        p.append(row("Естественная прокрутка", w["natural_scroll"]))

        # Внешний вид
        p = self.page("look", "Внешний вид")
        w["gaps_in"] = spin(0, 40, 1, s["gaps_in"])
        p.append(row("Отступ между окнами", w["gaps_in"]))
        w["gaps_out"] = spin(0, 60, 1, s["gaps_out"])
        p.append(row("Отступ от краёв экрана", w["gaps_out"]))
        w["border_size"] = spin(0, 6, 1, s["border_size"])
        p.append(row("Толщина рамки", w["border_size"]))
        w["animations"] = switch(s["animations"])
        p.append(row("Анимации", w["animations"]))
        w["border_anim"] = switch(s["border_anim"])
        p.append(row("Вращающаяся рамка активного окна", w["border_anim"]))
        w["dim_inactive"] = switch(s["dim_inactive"])
        p.append(row("Затемнять неактивные окна", w["dim_inactive"]))
        w["wallpaper"] = dropdown(WALLPAPER, s["wallpaper"])
        p.append(row("Обои", w["wallpaper"]))

        # Холст
        c = s["canvas"]
        p = self.page("canvas", "Бесконечный холст")
        w["spread"] = slider(1.0, 2.5, 0.05, c["spread"])
        p.append(row("Разъезд окон", w["spread"], "насколько окна расходятся при входе в холст"))
        w["shrink"] = slider(0.4, 1.0, 0.02, c["shrink"])
        p.append(row("Масштаб окон", w["shrink"], "размер окон после входа в холст"))
        w["pad"] = slider(0.0, 1.5, 0.05, c["pad"])
        p.append(row("Запас за краем", w["pad"], "насколько можно уехать за крайние окна (доля экрана)"))
        w["friction"] = slider(0.80, 0.98, 0.01, c["friction"])
        p.append(row("Инерция", w["friction"], "больше — дольше докатывается"))

        # Питание
        i = s["idle"]
        p = self.page("power", "Питание")
        w["lock"] = spin(0, 240, 1, i["lock"])
        p.append(row("Блокировка через", w["lock"], "минут бездействия, 0 — никогда"))
        w["screen_off"] = spin(0, 240, 1, i["screen_off"])
        p.append(row("Выключение экрана через", w["screen_off"], "минут, 0 — никогда"))
        w["suspend"] = spin(0, 480, 5, i["suspend"])
        p.append(row("Сон через", w["suspend"], "минут, 0 — никогда"))

        # Приложения
        p = self.page("apps", "Приложения")
        w["terminal"] = entry(s["terminal"])
        p.append(row("Терминал", w["terminal"], "Super + Enter"))
        w["browser"] = entry(s["browser"])
        p.append(row("Браузер", w["browser"], "Super + B"))
        w["files"] = entry(s["files"])
        p.append(row("Файловый менеджер", w["files"], "Super + E"))

        # Система
        p = self.page("system", "Система")
        grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3,
                           column_spacing=10, row_spacing=10, homogeneous=True)
        term = s["terminal"]
        tools = [
            ("Звук", ["pavucontrol"]),
            ("Сеть (Wi-Fi)", [term, "--class", "float", "-e", "impala"]),
            ("Bluetooth", [term, "--class", "float", "-e", "bluetoothctl"]),
            ("Обновить систему", [term, "--class", "float", "-e", "sh", "-c", "paru -Syu; read -p 'Enter — закрыть'"]),
            ("Папка dotfiles", [s["files"], os.path.join(HOME, "dotfiles")]),
            ("Перечитать Hyprland", ["hyprctl", "reload"]),
        ]
        for label, cmd in tools:
            needed = "bluetoothctl" if "bluetoothctl" in cmd else ("impala" if "impala" in cmd else cmd[0])
            if not shutil.which(cmd[0]) or not shutil.which(needed):
                continue
            b = Gtk.Button(label=label)
            b.add_css_class("tool")
            b.connect("clicked", lambda _b, c=cmd: spawn(*c))
            grid.append(b)
        p.append(grid)

    # ------------------------------------------------------------ футер
    def footer(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bar.add_css_class("footer")
        self.status = Gtk.Label(label="", xalign=0, hexpand=True)
        self.status.add_css_class("hint")
        reset = Gtk.Button(label="По умолчанию")
        reset.connect("clicked", self.on_reset)
        apply = Gtk.Button(label="Применить")
        apply.add_css_class("apply")
        apply.connect("clicked", self.on_apply)
        bar.append(self.status)
        bar.append(reset)
        bar.append(apply)
        return bar

    def collect(self):
        w = self.w
        s = deep_merge(DEFAULTS, {})
        s["monitors"] = {}
        for name, (mode_w, scale_w, pos_w) in self.mon.items():
            mode, scale = dd_value(mode_w), round(scale_w.get_value(), 2)
            pos = pos_w.get_text().strip() or "auto"
            if mode != "preferred" or scale != 1 or pos != "auto":
                s["monitors"][name] = {"mode": mode, "scale": scale, "position": pos}
        s["kb_layout"] = w["kb_layout"].get_text().strip() or DEFAULTS["kb_layout"]
        s["kb_options"] = dd_value(w["kb_switch"])
        for k in ("repeat_rate", "repeat_delay", "gaps_in", "gaps_out", "border_size"):
            s[k] = int(w[k].get_value())
        s["sensitivity"] = round(w["sensitivity"].get_value(), 2)
        for k in ("accel_flat", "natural_scroll", "animations", "border_anim", "dim_inactive"):
            s[k] = w[k].get_active()
        for k in ("terminal", "browser", "files"):
            s[k] = w[k].get_text().strip() or DEFAULTS[k]
        s["wallpaper"] = dd_value(w["wallpaper"])
        s["canvas"] = {k: round(w[k].get_value(), 2) for k in ("spread", "shrink", "pad", "friction")}
        s["idle"] = {k: int(w[k].get_value()) for k in ("lock", "screen_off", "suspend")}
        return s

    def on_apply(self, _btn):
        old = self.s
        new = self.collect()
        try:
            write_files(new)
        except OSError as e:
            self.status.set_text(f"Ошибка записи: {e}")
            return
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        if new["idle"] != old["idle"]:
            spawn("uwsm", "app", "--", os.path.join(SCRIPTS, "idle"))
        if new["wallpaper"] != old["wallpaper"]:
            spawn("uwsm", "app", "--", os.path.join(SCRIPTS, "wallpaper"))
        self.s = new
        errors = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True).stdout.strip()
        self.status.set_text("Ошибка в настройках — см. уведомление Hyprland" if errors else "Применено")
        GLib.timeout_add_seconds(4, lambda: self.status.set_text("") or False)

    def on_reset(self, _btn):
        dialog = Gtk.AlertDialog(message="Сбросить все настройки?",
                                 detail="Будут восстановлены значения по умолчанию.",
                                 buttons=["Отмена", "Сбросить"], cancel_button=0, default_button=0)
        dialog.choose(self, None, self._reset_done)

    def _reset_done(self, dialog, result):
        try:
            if dialog.choose_finish(result) != 1:
                return
        except GLib.Error:
            return
        for name in ("settings.json", "settings.lua", "hypridle.conf", "wallpaper"):
            try:
                os.remove(os.path.join(LOCAL, name))
            except FileNotFoundError:
                pass
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        spawn("uwsm", "app", "--", os.path.join(SCRIPTS, "idle"))
        spawn("uwsm", "app", "--", os.path.join(SCRIPTS, "wallpaper"))
        app = self.get_application()
        self.destroy()
        app.activate()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dotfiles.settings", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        win = self.get_active_window() or SettingsWindow(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
