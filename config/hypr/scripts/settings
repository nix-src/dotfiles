def _(text):
    return text if LANG == "ru" else EN.get(text, text)


DEFAULTS = {
    "monitors": {},
    "kb_layout": "us,ru",
    "kb_options": "grp:alt_shift_toggle",
    "sensitivity": 0.0,
    "accel_flat": False,
    "natural_scroll": False,
    "repeat_rate": 35,
    "repeat_delay": 250,
    "gaps_in": 4,
    "gaps_out": 8,
    "border_size": 1,
    "animations": True,
    "border_anim": False,
    "dim_inactive": True,
    "terminal": "kitty",
    "browser": "firefox",
    "files": "thunar",
    "canvas": {"spread": 1.35, "shrink": 0.82, "pad": 0.35, "friction": 0.94},
    "wallpaper": "animated",
    "idle": {"lock": 10, "screen_off": 15, "suspend": 0},
    "lang": "auto",
    "game_tearing": True,
    "game_classes": "",
}

LAYOUT_SWITCH = [
    ("Alt + Shift", "grp:alt_shift_toggle"),
    ("Ctrl + Shift", "grp:ctrl_shift_toggle"),
    ("Super + Space", "grp:win_space_toggle"),
    ("Caps Lock", "grp:caps_toggle"),
]
LANGS = [("авто (по системе)", "auto"), ("English", "en"), ("Русский", "ru")]
