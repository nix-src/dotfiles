JSON_PATH = os.path.join(LOCAL, "settings.json")

def detect_lang():
    try:
        out = subprocess.run([os.path.join(SCRIPTS, "lang")], capture_output=True, text=True, timeout=3)
        return "ru" if out.stdout.strip() == "ru" else "en"
    except (OSError, subprocess.TimeoutExpired):
        return "ru" if os.environ.get("LANG", "").startswith("ru") else "en"


