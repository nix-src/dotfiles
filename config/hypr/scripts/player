#!/usr/bin/env python3
"""Мини-плеер — всплывающая панель под треком в waybar — и хост окна настроек.

    player          фоновый процесс (запускается вместе с сессией)
    player toggle   показать/скрыть панель (клик по треку в waybar)

Тот же процесс открывает окно настроек по SIGUSR2 (scripts/settings шлёт
его сам): GTK уже загружен, поэтому окно появляется мгновенно.

Layer-shell поверхность (не окно): не участвует в тайлинге и фокусе,
появляется под курсором. Закрывается повторным кликом по треку, Escape
или когда курсор уходит с панели. Плееры отслеживаются через libplayerctl
(события, без опроса внешних программ). Фоновый процесс нужен, чтобы
панель появлялась мгновенно: клик лишь посылает ему сигнал.

Список плееров ведём сами (а не через PlayerManager.props.players): внутренний
список libplayerctl при исчезновении плееров может «сломаться», и процесс
зависал вместе с панелью. Команды плееру (пауза, перемотка) уходят по D-Bus
асинхронно — медленный плеер (Chromium, Electron) больше не тормозит панель.
Если главный цикл всё же зависнет, сторожевой таймер запишет стек в
~/.cache/dotfiles/player-hang.log и завершит процесс: панель исчезнет,
а следующий клик по треку запустит плеер заново.
"""
import os
import signal
import sys

PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "dotfiles-ui.pid")


def running_pid():
    """pid живого фонового процесса (проверяем, что это именно он, а не чужой pid)."""
    try:
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"scripts/player" not in f.read():
                return None
        return pid
    except (OSError, ValueError):
        return None


# Быстрый путь для клика: без загрузки GTK, просто сигнал фоновому процессу
if sys.argv[1:2] == ["toggle"]:
    pid = running_pid()
    if pid:
        os.kill(pid, signal.SIGUSR1)
        sys.exit(0)
    sys.argv = [sys.argv[0], "--show"]   # фонового процесса нет — запускаемся и сразу показываем

# gtk4-layer-shell должен загрузиться раньше libwayland-client
_LS = "/usr/lib/libgtk4-layer-shell.so"
if os.path.exists(_LS) and _LS not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = ":".join(x for x in (_LS, os.environ.get("LD_PRELOAD")) if x)
    os.execv(sys.executable, [sys.executable, *sys.argv])

import faulthandler  # noqa: E402
import hashlib  # noqa: E402
import json  # noqa: E402
import socket  # noqa: E402
import threading  # noqa: E402
import urllib.request  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Playerctl", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, Playerctl  # noqa: E402

# Библиотека layer-shell уже загружена; дочерним процессам (hyprctl, терминалы
# из настроек и т.п.) она не нужна и только замедляет их запуск.
_pre = [x for x in os.environ.get("LD_PRELOAD", "").split(":") if x and x != _LS]
if _pre:
    os.environ["LD_PRELOAD"] = ":".join(_pre)
else:
    os.environ.pop("LD_PRELOAD", None)

try:
    gi.require_version("GLibUnix", "2.0")
    from gi.repository import GLibUnix  # noqa: E402
except (ValueError, ImportError):     # старый GLib
    GLibUnix = type("GLibUnix", (), {"signal_add": staticmethod(GLib.unix_signal_add)})

try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402
except (ValueError, ImportError):
    LayerShell = None

PREV, PLAY, PAUSE, NEXT = "\U000f04ae", "\U000f040a", "\U000f03e4", "\U000f04ad"
NOTE = "\U000f075a"
WIDTH, COVER = 400, 96
CACHE = os.path.join(os.path.expanduser("~/.cache"), "dotfiles", "covers")
HANG_LOG = os.path.join(os.path.expanduser("~/.cache"), "dotfiles", "player-hang.log")
WATCHDOG = 20   # секунд без отклика главного цикла — процесс считается зависшим

CSS = """
window.miniplayer { background-color: #0f0f0f; border: 1px solid #2a2a2a; }
.panel { padding: 12px; }
.cover { background: #161616; }
.cover-icon { font-size: 30px; color: #3a3a3a; }
.title { font-size: 14px; font-weight: bold; color: #ededed; }
.artist { color: #a0a0a0; font-size: 12px; }
.player { color: #4f4f4f; font-size: 11px; }
.time { color: #6b6b6b; font-size: 11px; font-family: "JetBrainsMono Nerd Font", monospace; }
button.ctl { font-family: "JetBrainsMono Nerd Font"; font-size: 16px; min-width: 40px; min-height: 30px;
             padding: 0; background: transparent; border: none; box-shadow: none; color: #c8c8c8; }
button.ctl:hover { background: #1f1f1f; color: #ffffff; }
button.main { background: #c8c8c8; color: #0b0b0b; }
button.main:hover { background: #ededed; color: #0b0b0b; }
scale { padding: 4px 0; }
scale trough { min-height: 3px; background: #262626; border: none; }
scale highlight { background: #c8c8c8; border: none; }
scale slider { min-width: 10px; min-height: 10px; margin: -4px; background: #ededed;
               border: none; box-shadow: none; }
"""


def pick(players):
    """Активный плеер: сначала играющий, иначе на паузе; из нескольких —
    тот, что последним начал играть (players — список от старых к новым)."""
    for want in (Playerctl.PlaybackStatus.PLAYING, Playerctl.PlaybackStatus.PAUSED):
        for p in reversed(players):
            try:
                if p.props.playback_status == want and p.get_title():
                    return p
            except GLib.Error:
                continue
    return None


def safe(fn, default=None):
    try:
        return fn()
    except GLib.Error:
        return default


def mpris_call(player, method, args=None, fallback=None):
    """Асинхронный вызов метода MPRIS: главный цикл не ждёт ответа плеера."""
    try:
        if player.props.source != Playerctl.Source.DBUS_SESSION:
            raise GLib.Error("not a session bus player")
        inst = player.props.player_instance or player.props.player_name
        if not inst:
            raise GLib.Error("unknown player")
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)   # общий, уже открытый
        bus.call("org.mpris.MediaPlayer2." + inst,
                 "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", method,
                 args, None, Gio.DBusCallFlags.NO_AUTO_START, 3000, None, None)
    except GLib.Error:
        if fallback:
            safe(fallback)


def fmt_time(sec):
    sec = int(max(0, sec))
    return f"{sec // 60}:{sec % 60:02d}"


def hypr(cmd):
    """Запрос к Hyprland напрямую через его сокет (без запуска hyprctl)."""
    sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr",
                        os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""), ".socket.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(1)
        s.connect(sock)
        s.sendall(f"j/{cmd}".encode())
        data = b""
        while chunk := s.recv(65536):
            data += chunk
    return json.loads(data)


def right_margin():
    """Отступ справа, чтобы панель оказалась под курсором (в пределах монитора)."""
    try:
        cur = hypr("cursorpos")
        m = next(m for m in hypr("monitors") if m["focused"])
        width = m["width"] / m["scale"]
        x = cur["x"] - m["x"]
        return int(max(8, min(width - WIDTH - 8, width - x - WIDTH / 2)))
    except (OSError, ValueError, KeyError, StopIteration):
        return 8


def load_art(url, px, done):
    """Фоновый поток: скачать/прочитать обложку, обрезать до квадрата, вернуть PNG."""
    png = None
    try:
        if url.startswith("file://"):
            path = GLib.filename_from_uri(url)[0]
        else:
            os.makedirs(CACHE, exist_ok=True)
            path = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest())
            if not os.path.exists(path):
                req = urllib.request.Request(url, headers={"User-Agent": "mini-player"})
                with urllib.request.urlopen(req, timeout=5) as r, open(path + ".part", "wb") as f:
                    f.write(r.read(5_000_000))
                os.replace(path + ".part", path)
        pb = GdkPixbuf.Pixbuf.new_from_file(path)
        side = min(pb.get_width(), pb.get_height())
        pb = pb.new_subpixbuf((pb.get_width() - side) // 2, (pb.get_height() - side) // 2, side, side)
        pb = pb.scale_simple(px, px, GdkPixbuf.InterpType.BILINEAR)
        png = pb.save_to_bufferv("png", [], [])[1]
    except (OSError, GLib.Error):
        png = None
    GLib.idle_add(done, url, png)


class Popup(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Player")
        self.add_css_class("miniplayer")
        self.set_default_size(WIDTH, -1)
        self.set_resizable(False)
        self.player = None
        self.art_url = None
        self.length = 0.0
        self.seek_until = 0      # не обновлять ползунок, пока пользователь его тянет
        self.seek_timer = 0
        self.leave_timer = 0

        if LayerShell and LayerShell.is_supported():
            LayerShell.init_for_window(self)
            LayerShell.set_namespace(self, "miniplayer")
            LayerShell.set_layer(self, LayerShell.Layer.TOP)
            LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
            LayerShell.set_anchor(self, LayerShell.Edge.RIGHT, True)
            LayerShell.set_margin(self, LayerShell.Edge.TOP, 6)
            LayerShell.set_margin(self, LayerShell.Edge.RIGHT, 8)   # точный — при показе
            LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.ON_DEMAND)
        else:
            self.set_decorated(False)

        self.build()

        self.app = app
        self.closing = False
        self.tick_id = 0
        self.connect("destroy", self.on_destroy)

    def prepare(self):
        """Подготовить заранее, не показывая: поверхность, отрисовщик и шрифты.
        Первый показ GTK-окна иначе стоит ~250 мс, подготовленного — ~20 мс."""
        self.realize()
        self.get_child().measure(Gtk.Orientation.HORIZONTAL, -1)
        return self

    def show_popup(self):
        if LayerShell and LayerShell.is_supported():
            LayerShell.set_margin(self, LayerShell.Edge.RIGHT, right_margin())
        self.tick_id = GLib.timeout_add(250, self.tick)
        self.update()
        if not self.closing:
            self.present()

    def on_destroy(self, *_):
        for attr in ("tick_id", "seek_timer", "leave_timer"):
            if getattr(self, attr):
                GLib.source_remove(getattr(self, attr))
                setattr(self, attr, 0)
        self.player = None

    def close_once(self):
        """Закрыть панель (повторные вызовы и вызовы после уничтожения игнорируются)."""
        if not self.closing:
            self.closing = True
            self.close()
        return False

    # ------------------------------------------------------------ интерфейс
    def build(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        panel.add_css_class("panel")

        self.cover = Gtk.Stack(hexpand=False, halign=Gtk.Align.START, valign=Gtk.Align.CENTER)
        self.cover.add_css_class("cover")
        self.cover.set_size_request(COVER, COVER)
        icon = Gtk.Label(label=NOTE)
        icon.add_css_class("cover-icon")
        self.cover.add_named(icon, "icon")
        self.art = Gtk.Image(pixel_size=COVER)
        self.cover.add_named(self.art, "art")
        panel.append(self.cover)

        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True,
                      valign=Gtk.Align.CENTER)
        self.title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, hexpand=True)
        self.title.add_css_class("title")
        self.artist = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, hexpand=True)
        self.artist.add_css_class("artist")
        self.source = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, hexpand=True)
        self.source.add_css_class("player")
        for w in (self.title, self.artist, self.source):
            col.append(w)

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.scale.set_draw_value(False)
        self.scale.connect("change-value", self.on_seek)
        col.append(self.scale)

        times = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.pos_l = Gtk.Label(xalign=0, hexpand=True)
        self.len_l = Gtk.Label(xalign=1)
        for w in (self.pos_l, self.len_l):
            w.add_css_class("time")
            times.append(w)
        col.append(times)

        ctl = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, halign=Gtk.Align.CENTER)
        self.b_prev = self.button(PREV, lambda p: mpris_call(p, "Previous", fallback=p.previous))
        self.b_play = self.button(PLAY, self.play_pause)
        self.b_play.add_css_class("main")
        self.b_next = self.button(NEXT, lambda p: mpris_call(p, "Next", fallback=p.next))
        for b in (self.b_prev, self.b_play, self.b_next):
            ctl.append(b)
        col.append(ctl)
        panel.append(col)
        self.set_child(panel)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        motion = Gtk.EventControllerMotion()
        motion.connect("enter", self.on_enter)
        motion.connect("leave", self.on_leave)
        self.add_controller(motion)

    def button(self, icon, action):
        b = Gtk.Button(label=icon)
        b.add_css_class("ctl")
        b.set_focusable(False)
        b.connect("clicked", lambda _b: self.player and safe(lambda: action(self.player)))
        return b

    def play_pause(self, p):
        mpris_call(p, "PlayPause", fallback=p.play_pause)
        # иконку меняем сразу, не дожидаясь ответа плеера (событие придёт следом)
        playing = safe(lambda: p.props.playback_status) == Playerctl.PlaybackStatus.PLAYING
        self.b_play.set_label(PLAY if playing else PAUSE)

    # -------------------------------------------------------------- плееры
    def update(self):
        if self.closing:
            return
        self.player = pick(self.app.player_list())
        p = self.player
        if p is None:
            # нечего показывать — закрываемся
            GLib.idle_add(self.close_once)
            return
        self.title.set_text(safe(p.get_title, "") or "")
        self.artist.set_text(" · ".join(x for x in (safe(p.get_artist, ""), safe(p.get_album, "")) if x))
        self.source.set_text(safe(lambda: p.props.player_name, "") or "")
        playing = safe(lambda: p.props.playback_status) == Playerctl.PlaybackStatus.PLAYING
        self.b_play.set_label(PAUSE if playing else PLAY)
        try:
            self.length = int(safe(lambda: p.print_metadata_prop("mpris:length"), "0") or 0) / 1e6
        except ValueError:
            self.length = 0.0
        if self.length > 0:
            self.scale.set_sensitive(True)
            self.scale.set_range(0, self.length)
            self.len_l.set_text(fmt_time(self.length))
        else:
            self.scale.set_sensitive(False)
            self.len_l.set_text("")
        self.show_art(safe(lambda: p.print_metadata_prop("mpris:artUrl"), "") or None)
        self.tick()

    def tick(self):
        p = self.player
        if p is not None and not self.closing:
            # позиция берётся из кэша libplayerctl (без запроса к плееру)
            pos = max(0.0, (safe(lambda: p.props.position, 0) or 0) / 1e6)
            if self.length:
                pos = min(pos, self.length)
            if GLib.get_monotonic_time() > self.seek_until:
                self.scale.set_value(pos if self.length else 0)
                self.pos_l.set_text(fmt_time(pos))
        return True

    def on_seek(self, _scale, _scroll, value):
        # пока тянут ползунок — только показываем время, перематываем после паузы в движении
        value = max(0.0, min(value, self.length))
        self.seek_until = GLib.get_monotonic_time() + 600_000
        self.pos_l.set_text(fmt_time(value))
        if self.seek_timer:
            GLib.source_remove(self.seek_timer)
        self.seek_timer = GLib.timeout_add(200, self.do_seek, value)
        return False

    def do_seek(self, value):
        self.seek_timer = 0
        p = self.player
        if p:
            usec = int(value * 1e6)
            track = safe(lambda: p.print_metadata_prop("mpris:trackid"), "") or ""
            if track.startswith("/") and GLib.Variant.is_object_path(track):
                mpris_call(p, "SetPosition", GLib.Variant("(ox)", (track, usec)),
                           fallback=lambda: p.set_position(usec))
            else:
                safe(lambda: p.set_position(usec))
            # ползунок держим на новом месте, пока плеер не подтвердит перемотку
            self.seek_until = GLib.get_monotonic_time() + 1_000_000
        return False

    # -------------------------------------------------------------- обложка
    def show_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        cache = self.get_application().art_cache
        if url in cache:
            self.apply_art(url, cache[url])
            return
        self.cover.set_visible_child_name("icon")
        if url and url.startswith(("file://", "http://", "https://")):
            px = COVER * max(1, self.get_scale_factor())
            app = self.get_application()
            threading.Thread(target=load_art, args=(url, px, app.on_art_loaded), daemon=True).start()

    def apply_art(self, url, texture):
        if url != self.art_url:
            return
        if texture is None:
            self.cover.set_visible_child_name("icon")
        else:
            self.art.set_from_paintable(texture)
            self.cover.set_visible_child_name("art")

    # ------------------------------------------------------------ закрытие
    def on_key(self, _ctl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close_once()
            return True
        if keyval == Gdk.KEY_space and self.player:
            self.play_pause(self.player)
            return True
        return False

    def on_enter(self, *_):
        if self.leave_timer:
            GLib.source_remove(self.leave_timer)
            self.leave_timer = 0

    def on_leave(self, *_):
        if not self.leave_timer:
            self.leave_timer = GLib.timeout_add(700, self.close_from_timer)

    def close_from_timer(self):
        self.leave_timer = 0
        return self.close_once()


class App(Gtk.Application):
    def __init__(self, show):
        super().__init__(application_id="dotfiles.shell", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.show_on_start = show
        self.popup = None
        self.art_cache = {}   # url -> Gdk.Texture (или None, если не загрузилась)
        # Одно подключение к плеерам на весь процесс: события приходят всегда,
        # а панель при открытии просто берёт готовое состояние.
        # PlayerManager нужен только для событий появления/исчезновения имён;
        # сами плееры храним в своём словаре (instance -> Player), порядок —
        # от давно игравших к недавним.
        self.players = {}
        self.manager = Playerctl.PlayerManager()
        self.manager.connect("name-appeared", lambda _m, name: self.watch(name))
        self.manager.connect("name-vanished", lambda _m, name: self.unwatch(name))
        for name in self.manager.props.player_names:
            self.watch(name)

    def player_list(self):
        return list(self.players.values())

    def watch(self, name):
        key = name.instance
        if key in self.players:
            return
        try:
            p = Playerctl.Player.new_from_name(name)
        except GLib.Error:
            return
        p.connect("playback-status", lambda pl, status: self.on_status(key, pl, status))
        p.connect("metadata", lambda *_: self.changed())
        p.connect("seeked", lambda *_: self.popup and self.popup.tick())
        self.players[key] = p
        self.changed()

    def unwatch(self, name):
        if self.players.pop(name.instance, None) is not None:
            self.changed()

    def on_status(self, key, player, status):
        # начавший играть плеер — в конец списка (он «самый свежий»)
        if status == Playerctl.PlaybackStatus.PLAYING and self.players.get(key) is player:
            self.players[key] = self.players.pop(key)
        self.changed()

    def changed(self):
        if self.popup is not None:
            self.popup.update()

    def on_art_loaded(self, url, png):
        texture = Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)) if png else None
        if len(self.art_cache) > 20:
            self.art_cache.clear()
        self.art_cache[url] = texture
        if self.popup is not None:
            self.popup.apply_art(url, texture)
        return False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.hold()   # живём в фоне и без окон
        with open(PIDFILE, "w") as f:
            f.write(str(os.getpid()))
        self.start_watchdog()
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.toggle)
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, self.open_settings)
        self.settings_ready = None
        self.settings_lang = None
        self.connect("window-removed", self.on_window_removed)
        self.popup_ready = None
        GLib.timeout_add(800, self.prebuild_popup)       # заранее, чтобы первое открытие было мгновенным
        GLib.timeout_add(1500, self.prebuild_settings)
        for sig in (signal.SIGTERM, signal.SIGINT):
            GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, sig, self.quit_clean)

    # ------------------------------------------------------- сторожевой таймер
    # faulthandler работает в отдельном C-потоке и не нуждается в GIL, поэтому
    # срабатывает, даже если главный поток застрял внутри C-библиотеки.
    # Главный цикл каждые 2 с отодвигает срок; не успел за WATCHDOG секунд —
    # стек пишется в HANG_LOG, процесс завершается (вместе с панелью).
    def start_watchdog(self):
        try:
            os.makedirs(os.path.dirname(HANG_LOG), exist_ok=True)
            self.hang_log = open(HANG_LOG, "a")
        except OSError:
            self.hang_log = sys.stderr
        faulthandler.register(signal.SIGQUIT, file=self.hang_log, all_threads=True)
        self.heartbeat()
        GLib.timeout_add_seconds(2, self.heartbeat)

    def heartbeat(self):
        faulthandler.dump_traceback_later(WATCHDOG, exit=True, file=self.hang_log)
        return True

    def do_activate(self):
        if self.show_on_start:
            self.show_on_start = False
            self.toggle()

    def toggle(self):
        if self.popup is not None:          # повторный клик по треку — закрыть
            self.popup.close_once()
        elif pick(self.player_list()) is not None:
            win, self.popup_ready = self.popup_ready, None
            self.popup = win or Popup(self)
            self.popup.connect("close-request", self.on_popup_closed)
            self.popup.show_popup()
            GLib.timeout_add(500, self.prebuild_popup)   # следующая — тоже заранее
        return True

    # Панель, как и окно настроек, строится заранее и ждёт скрытой.
    def prebuild_popup(self):
        if self.popup_ready is None:
            self.popup_ready = Popup(self).prepare()
        return False

    # ------------------------------------------------------------ настройки
    # Окно настроек строится заранее и ждёт скрытым: по клику его остаётся
    # только показать. После закрытия готовится новое (со свежими значениями).
    def prebuild_settings(self):
        self.load_settings()
        mod = self.settings_mod
        if self.settings_ready is None and not any(isinstance(w, mod.SettingsWindow) for w in self.get_windows()):
            mod.LANG = mod.detect_lang()
            self.settings_ready = mod.SettingsWindow(self)
            self.settings_ready.realize()     # поверхность и отрисовщик готовятся заранее
            self.settings_lang = mod.LANG
        return False

    def on_window_removed(self, _app, win):
        if win is self.popup:               # панель уничтожена любым путём
            self.popup = None
        if win is self.popup_ready:
            self.popup_ready = None
        mod = getattr(self, "settings_mod", None)
        if mod and isinstance(win, mod.SettingsWindow) and win is not self.settings_ready:
            GLib.timeout_add(300, self.prebuild_settings)

    def load_settings(self):
        if getattr(self, "settings_mod", None) is None:
            import importlib.machinery
            import importlib.util
            path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "settings")
            loader = importlib.machinery.SourceFileLoader("dotfiles_settings", path)
            spec = importlib.util.spec_from_loader("dotfiles_settings", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            css = Gtk.CssProvider()
            css.load_from_string(mod.CSS)
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.settings_mod = mod
        return False

    def open_settings(self):
        self.load_settings()
        mod = self.settings_mod
        for w in self.get_windows():          # уже открыто — просто поднять
            if isinstance(w, mod.SettingsWindow) and w is not self.settings_ready:
                w.present()
                return True
        win, self.settings_ready = self.settings_ready, None
        if win is None or mod.detect_lang() != self.settings_lang:   # язык сменился — пересобрать
            if win is not None:
                win.destroy()
            mod.LANG = mod.detect_lang()
            win = mod.SettingsWindow(self)
        win.present()
        return True

    def on_popup_closed(self, w):
        w.closing = True
        if self.popup is w:
            self.popup = None
        return False   # окно закрывается и уничтожается как обычно

    def quit_clean(self):
        try:
            if running_pid() == os.getpid():
                os.remove(PIDFILE)
        except OSError:
            pass
        faulthandler.cancel_dump_traceback_later()
        self.quit()
        return False


if __name__ == "__main__":
    if running_pid() and "--show" not in sys.argv:
        sys.exit(0)   # уже запущен
    sys.exit(App("--show" in sys.argv).run([sys.argv[0]]))
