#!/usr/bin/env bash
# Мгновенный вызов уже запущенных фоновых процессов — клик лишь посылает сигнал:
#   ui player       показать/скрыть мини-плеер          (scripts/player)
#   ui settings     открыть окно настроек               (scripts/player)
#   ui play-pause   пауза/продолжить показанный трек    (scripts/media)
#   ui next         следующий трек                      (scripts/media)
# Если нужного процесса нет — запускаем скрипт напрямую (медленнее).
dir="$HOME/.config/hypr/scripts"
run="${XDG_RUNTIME_DIR:-/tmp}"

case "${1:-}" in
    player)     pidfile=$run/dotfiles-ui.pid;    owner=scripts/player; sig=USR1; fallback=("$dir/player" toggle) ;;
    settings)   pidfile=$run/dotfiles-ui.pid;    owner=scripts/player; sig=USR2; fallback=("$dir/settings" --standalone) ;;
    play-pause) pidfile=$run/dotfiles-media.pid; owner=scripts/media;  sig=USR1; fallback=("$dir/media" play-pause) ;;
    next)       pidfile=$run/dotfiles-media.pid; owner=scripts/media;  sig=USR2; fallback=("$dir/media" next) ;;
    *) echo "usage: ui player|settings|play-pause|next" >&2; exit 1 ;;
esac

if [[ -r $pidfile ]]; then
    pid="$(<"$pidfile")"
    # сигнал только нашему процессу: pid мог достаться другой программе
    if [[ $pid =~ ^[0-9]+$ ]] && [[ -r /proc/$pid/cmdline ]]; then
        mapfile -d '' args < "/proc/$pid/cmdline"      # без tr/grep: ни одного лишнего процесса
        if [[ "${args[*]}" == *"$owner"* ]]; then
            kill -"$sig" "$pid" && exit 0
        fi
    fi
fi
exec "${fallback[@]}"
