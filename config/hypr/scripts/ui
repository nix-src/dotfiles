#!/usr/bin/env bash
# Мгновенный вызов окон фонового процесса (scripts/player):
#   ui player     показать/скрыть мини-плеер
#   ui settings   открыть окно настроек
# Если фоновый процесс не запущен — запускаем нужный скрипт напрямую.
dir="$HOME/.config/hypr/scripts"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-ui.pid"

case "${1:-}" in
    player)   sig=USR1; fallback=("$dir/player" toggle) ;;
    settings) sig=USR2; fallback=("$dir/settings" --standalone) ;;
    *) echo "usage: ui player|settings" >&2; exit 1 ;;
esac

if [[ -r $pidfile ]]; then
    pid="$(<"$pidfile")"
    # сигнал только нашему процессу: pid мог достаться другой программе
    if [[ $pid =~ ^[0-9]+$ ]] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'scripts/player'; then
        exec kill -"$sig" "$pid"
    fi
fi
exec "${fallback[@]}"
