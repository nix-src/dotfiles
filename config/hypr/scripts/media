#!/usr/bin/env python3
"""Модуль waybar custom/media: текущий трек из любого MPRIS-плеера.

Работает на событиях libplayerctl (без опроса). Печатает JSON для waybar
при каждом изменении. Когда ничего не играет и нет трека на паузе —
печатает пустую строку, и waybar прячет модуль.

    media              модуль для waybar (exec)
    media play-pause   управлять тем плеером, что сейчас показан в модуле
    media next | previous

Клики по модулю идут через scripts/ui: он лишь посылает сигнал уже
запущенному модулю (SIGUSR1 — пауза, SIGUSR2 — следующий трек), а тот
отправляет команду плееру асинхронно и сразу меняет значок. Python и
playerctl при клике не запускаются, поэтому отклик мгновенный.
Без работающего модуля команды выполняет playerctl (медленнее).
"""
import html
import json
import os
import signal
import sys

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
CURRENT = os.path.join(RUNTIME, "dotfiles-media-player")   # показанный плеер
PIDFILE = os.path.join(RUNTIME, "dotfiles-media.pid")

# Запасной путь для команд (модуль не запущен): без загрузки GObject
if sys.argv[1:2] and sys.argv[1] in ("play-pause", "next", "previous"):
    try:
        with open(CURRENT) as f:
            inst = f.read().strip()
    except OSError:
        inst = ""
    cmd = ["playerctl", *(["-p", inst] if inst else []), sys.argv[1]]
    os.execvp(cmd[0], cmd)

import gi  # noqa: E402

gi.require_version("Playerctl", "2.0")
from gi.repository import Gio, GLib, Playerctl  # noqa: E402

try:
    gi.require_version("GLibUnix", "2.0")
    from gi.repository import GLibUnix  # noqa: E402
    signal_add = GLibUnix.signal_add
except (ValueError, ImportError):     # старый GLib
    signal_add = GLib.unix_signal_add

PLAY, PAUSE = "\U000f040a", "\U000f03e4"
MAX = 40
PLAYING = Playerctl.PlaybackStatus.PLAYING


def pick(players):
    """Активный плеер: сначала играющий, иначе на паузе; из нескольких —
    тот, что последним начал играть (players — список от старых к новым)."""
    for want in (PLAYING, Playerctl.PlaybackStatus.PAUSED):
        for p in reversed(players):
            try:
                if p.props.playback_status == want and p.get_title():
                    return p
            except GLib.Error:
                continue
    return None


def instance(p):
    return (p.props.player_instance or p.props.player_name or "") if p is not None else ""


def mpris_call(player, method, fallback):
    """Асинхронный вызов метода MPRIS: не ждём ответа плеера."""
    try:
        inst = instance(player)
        if player.props.source != Playerctl.Source.DBUS_SESSION or not inst:
            raise GLib.Error("not a session bus player")
        Gio.bus_get_sync(Gio.BusType.SESSION, None).call(
            "org.mpris.MediaPlayer2." + inst, "/org/mpris/MediaPlayer2",
            "org.mpris.MediaPlayer2.Player", method, None, None,
            Gio.DBusCallFlags.NO_AUTO_START, 3000, None, None)
    except GLib.Error:
        try:
            fallback()
        except GLib.Error:
            pass


class Module:
    def __init__(self):
        self.last = None
        self.current = None
        self.shown = None          # плеер, показанный в модуле сейчас
        self.optimistic = None     # (плеер, играет?) — до подтверждения от плеера
        self.optimistic_timer = 0
        # Список плееров ведём сами (instance -> Player), а PlayerManager
        # используем только для событий: его внутренний список ненадёжен.
        self.players = {}
        self.manager = Playerctl.PlayerManager()
        self.manager.connect("name-appeared", lambda _m, name: self.add(name))
        self.manager.connect("name-vanished", lambda _m, name: self.remove(name))
        for name in self.manager.props.player_names:
            self.add(name)
        self.emit()
        # страховка на случай, если плеер не прислал событие
        GLib.timeout_add_seconds(3, lambda: self.emit() or True)
        # клики по модулю (через scripts/ui)
        signal_add(GLib.PRIORITY_HIGH, signal.SIGUSR1, self.play_pause)
        signal_add(GLib.PRIORITY_HIGH, signal.SIGUSR2, self.next)
        try:
            with open(PIDFILE + ".tmp", "w") as f:
                f.write(str(os.getpid()))
            os.replace(PIDFILE + ".tmp", PIDFILE)
        except OSError:
            pass

    def add(self, name):
        key = name.instance
        if key in self.players:
            return
        try:
            player = Playerctl.Player.new_from_name(name)
        except GLib.Error:
            return
        player.connect("playback-status", lambda pl, st: self.on_status(key, pl, st))
        player.connect("metadata", lambda *_: self.emit())
        self.players[key] = player
        self.emit()

    def remove(self, name):
        if self.players.pop(name.instance, None) is not None:
            self.emit()

    def on_status(self, key, player, status):
        # начавший играть плеер — в конец списка (он «самый свежий»)
        if status == PLAYING and self.players.get(key) is player:
            self.players[key] = self.players.pop(key)
        if self.optimistic and self.optimistic[0] is player:
            self.clear_optimistic()
        self.emit()

    # ---------------------------------------------------------------- клики
    def play_pause(self):
        p = self.shown
        if p is not None:
            mpris_call(p, "PlayPause", p.play_pause)
            # значок меняем сразу; настоящее состояние придёт событием
            try:
                playing = p.props.playback_status == PLAYING
            except GLib.Error:
                playing = False
            self.optimistic = (p, not playing)
            if self.optimistic_timer:
                GLib.source_remove(self.optimistic_timer)
            self.optimistic_timer = GLib.timeout_add(1500, self.clear_optimistic)
            self.emit()
        return True

    def next(self):
        p = self.shown
        if p is not None:
            mpris_call(p, "Next", p.next)
        return True

    def clear_optimistic(self):
        if self.optimistic_timer:
            GLib.source_remove(self.optimistic_timer)
        self.optimistic_timer = 0
        if self.optimistic is not None:
            self.optimistic = None
            self.emit()
        return False

    # ---------------------------------------------------------------- вывод
    def remember(self, p):
        self.shown = p
        inst = instance(p)
        if inst != self.current:
            self.current = inst
            try:
                with open(CURRENT + ".tmp", "w") as f:
                    f.write(inst)
                os.replace(CURRENT + ".tmp", CURRENT)
            except OSError:
                pass

    def render(self):
        # плеер, которому только что нажали паузу, остаётся показанным
        p = self.optimistic[0] if self.optimistic else pick(list(self.players.values()))
        if p is not None and p not in self.players.values():
            self.optimistic = None
            p = pick(list(self.players.values()))
        self.remember(p)
        if p is None:
            return {"text": "", "class": "idle"}
        try:
            title, artist = p.get_title() or "", p.get_artist() or ""
            playing = p.props.playback_status == PLAYING
        except GLib.Error:
            return {"text": "", "class": "idle"}
        if self.optimistic:
            playing = self.optimistic[1]
        label = f"{artist} — {title}" if artist else title
        short = label if len(label) <= MAX else label[: MAX - 1] + "…"
        return {
            # иконка того же кегля, что и значки-кнопки в панели (15px)
            "text": f"<span size='11.25pt'>{PLAY if playing else PAUSE}</span>  {html.escape(short)}",
            "class": "playing" if playing else "paused",
        }

    def emit(self):
        out = json.dumps(self.render(), ensure_ascii=False)
        if out != self.last:
            self.last = out
            try:
                print(out, flush=True)
            except BrokenPipeError:
                sys.exit(0)


if __name__ == "__main__":
    Module()
    try:
        GLib.MainLoop().run()
    except KeyboardInterrupt:
        pass
