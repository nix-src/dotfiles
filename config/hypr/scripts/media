#!/usr/bin/env python3
"""Модуль waybar custom/media: текущий трек из любого MPRIS-плеера.

Печатает JSON для waybar при каждом изменении. Когда ничего не играет —
только иконка ноты (по клику всё равно открывается мини-плеер).
"""
import html
import json
import os
import subprocess
import sys
import time

NOTE, PLAY, PAUSE = "\U000f075a", "\U000f040a", "\U000f03e4"
MAX = 40
SEP = "\x1f"
FMT = SEP.join(["{{status}}", "{{artist}}", "{{title}}", "{{playerName}}"])


def lang():
    try:
        out = subprocess.run([os.path.expanduser("~/.config/hypr/scripts/lang")],
                             capture_output=True, text=True, timeout=3)
        return out.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return "en"


IDLE_TIP = "Ничего не играет" if lang() == "ru" else "Nothing playing"


def query():
    try:
        out = subprocess.run(["playerctl", "metadata", "--format", FMT],
                             capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return None
    parts = out.stdout.rstrip("\n").split(SEP)
    if out.returncode != 0 or len(parts) != 4:
        return None
    status, artist, title, player = parts
    if status == "Stopped" or not title:
        return None
    return status, artist, title, player


def render(info):
    if info is None:
        return {"text": NOTE, "class": "idle", "tooltip": IDLE_TIP}
    status, artist, title, player = info
    label = f"{artist} — {title}" if artist else title
    short = label if len(label) <= MAX else label[: MAX - 1] + "…"
    icon = PLAY if status == "Playing" else PAUSE
    return {
        "text": f"{icon}  {html.escape(short)}",
        "class": "playing" if status == "Playing" else "paused",
        "tooltip": html.escape(f"{label}\n{player}"),
    }


def main():
    last = None
    while True:
        out = json.dumps(render(query()), ensure_ascii=False)
        if out != last:
            print(out, flush=True)
            last = out
        time.sleep(1)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
